<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{518E0636-BA8F-459D-ACAC-81BD33475E3E}</ProjectGuid>
    <RootNamespace>Mapper</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>Mapper</TargetName>
    <!-- Build scratch lives outside the repository, under %TEMP%\amager_build,
     so no build output or intermediate ever lands in the source tree.
     $(ProjectName) in IntDir is load bearing: a shared intermediate folder
     makes the two projects race for the same .obj files, which shows up as
     MSB8028 plus LNK1181 on a parallel build. -->
    <IntDir>$(TEMP)\amager_build\obj\$(ProjectName)\</IntDir>
    <OutDir>$(TEMP)\amager_build\bin\</OutDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- SDLCheck stays off, as it was before stack protection was restored.
       It enabled /sdl, which forced /GS on and overrode the old per-file /GS-;
       /GS is now requested directly by BufferSecurityCheck below. -->
      <SDLCheck>false</SDLCheck>
      <!-- Stack protection is ON. /GS and /EHa are expressed as the properties
       that emit them, so each flag reaches cl exactly once. Written as raw
       AdditionalOptions text they left the defaults (/GS, /EHsc) on the command
       line as well, and cl warned D9025 ("overriding ...") on every translation
       unit. /GS- was originally added for a 0xC0000096 crash that turned out to
       be STATUS_PRIVILEGED_INSTRUCTION (a ring 3 RDMSR), not a stack buffer
       overrun, so there is nothing left to work around. -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ConformanceMode>true</ConformanceMode>
      <TreatWarningAsError>false</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Async</ExceptionHandling>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- App\Hypervisor.h is a local copy, kept in sync with the hypervisor
       client library by hand (see the CallIoctl comment there). No include
       directory outside this solution is needed to build Mapper. -->
      <!-- /EHc has no MSBuild property. The previous "/EHsc ... /EHa" pairing kept
       the "extern C never throws" half of /EHsc, and ExceptionHandling=Async on
       its own drops it: the tail calls through extern "C" imports turn into
       call/ret and the shipped .text changes. Restated here so the code stays
       byte for byte what it was before this cleanup. -->
      <AdditionalOptions>/EHc %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <UACExecutionLevel>RequireAdministrator</UACExecutionLevel>
    </Link>
    <PostBuildEvent>
      <!-- Copies the two symbol libraries into $(OutDir)\DLLs, which is where
     SymbolEngine looks for them. The two files are named explicitly on purpose:
      a Utilities\DLLs\* wildcard could pick up unrelated files placed next
      to these two binaries later. -->
    <Command>if not exist "$(OutDir)DLLs" mkdir "$(OutDir)DLLs"
copy /y "$(SolutionDir)..\Utilities\DLLs\dbghelp.dll" "$(OutDir)DLLs\" >nul
copy /y "$(SolutionDir)..\Utilities\DLLs\symsrv.dll" "$(OutDir)DLLs\" >nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- App -->
    <!-- Main.cpp inlines Hypervisor.h; CallVM catches the hardware #UD from a
      vmmcall with catch(...), which needs /EHa (set globally). -->
    <ClCompile Include="..\..\App\Main.cpp" />
    <ClCompile Include="..\..\App\Probing\Probe.cpp" />
    <!-- Mapper -->
    <ClCompile Include="..\..\Mapper\Mapper.cpp" />
    <!-- PE -->
    <ClCompile Include="..\..\Parsing\PE.cpp" />
    <!-- Provider -->
    <ClCompile Include="..\..\Provider\Core\Driver.cpp" />
    <!-- Service -->
    <ClCompile Include="..\..\Service\Service.cpp" />
    <!-- Symbols -->
    <ClCompile Include="..\..\Symbols\Handler\SymbolsHandler.cpp" />
    <!-- Utilities -->
    <ClCompile Include="..\..\Utilities\Support\Utilities.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- App -->
    <ClInclude Include="..\..\App\NT.hpp" />
    <ClInclude Include="..\..\App\Hypervisor.h" />
    <ClInclude Include="..\..\App\Probing\Probe.h" />
    <!-- Mapper -->
    <ClInclude Include="..\..\Mapper\Mapper.hpp" />
    <!-- PE -->
    <ClInclude Include="..\..\Parsing\PE.hpp" />
    <!-- Provider -->
    <ClInclude Include="..\..\Provider\Core\Driver.hpp" />
    <ClInclude Include="..\..\Provider\Provider.hpp" />
    <ClInclude Include="..\..\Provider\Resource.hpp" />
    <!-- Service -->
    <ClInclude Include="..\..\Service\Service.hpp" />
    <!-- Symbols -->
    <ClInclude Include="..\..\Symbols\Handler\SymbolsHandler.hpp" />
    <!-- Utilities -->
    <ClInclude Include="..\..\Utilities\Support\Console.hpp" />
    <ClInclude Include="..\..\Utilities\Support\Utilities.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
